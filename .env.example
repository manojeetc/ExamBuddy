# Copy this file to .env and fill in the real value. Never commit .env.
# Rotate the Supabase database password if it was ever shared in chat,
# a screenshot, or a commit — treat any exposed credential as compromised.
#
# STORAGE_BACKEND selects where exam sessions and the Read List are stored:
#   csv      - local Response/*.json + Response/*.csv + ReadList/read_list.json (default)
#   supabase - the Postgres tables defined in supabase/schema.sql
STORAGE_BACKEND=csv
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
